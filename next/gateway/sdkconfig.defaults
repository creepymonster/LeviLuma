# LeviLuma Gateway – Seeed XIAO ESP32S3
CONFIG_IDF_TARGET="esp32s3"

# Flash: 4 MB-Layout, laeuft auf jedem XIAO ESP32S3 (die Flashgroesse ist im Repo nicht bestaetigt)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Konsole ueber USB-Serial-JTAG (USB-C des XIAO)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE: NimBLE, nur Central/Observer, eine Verbindung
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# WLAN nur fuer ESP-NOW; BLE und WLAN teilen sich das Funkteil (Software-Koexistenz)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=6

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
