# LeviLuma Controller – RockBase NM-CYD-C5 (ESP32-C5-WROOM-1-N16R8 laut Schaltplan)
CONFIG_IDF_TARGET="esp32c5"

# 16 MB Flash, eigene Partitionstabelle (NVS gross genug fuer Register und Zigbee)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB PSRAM (Quad-SPI) fuer LVGL-Speicher
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ESP-NOW: WLAN nur als Funk, keine Verbindung; bis zu 10 verschluesselte Peers (8 Gateways + Kopplung)
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=10

# LVGL 9.6 (Konfiguration ueber Kconfig, kein lv_conf.h)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_THEME_DEFAULT=y
