# Erzeugt fuer den Simulator eine sdkconfig.h aus den Kconfig-Dateien der Firmware.
#
# Statt die Werte (Name des Controllers, Zeiten, Kanal ...) im Simulator zu wiederholen, werden die
# Standardwerte direkt aus den Kconfig-Dateien gelesen und mit den Eintraegen aus der
# sdkconfig.defaults des Projekts ueberschrieben, genau wie bei einem frischen ESP-IDF-Build.
#
# Unterstuetzt wird nur, was die LeviLuma-Kconfig-Dateien nutzen: config/bool/int/hex/string,
# das erste "default" (ohne Bedingung), choice/endchoice mit Standardauswahl. "depends on" wird nicht
# ausgewertet: abhaengige Optionen erscheinen mit ihrem Standardwert (bool n fehlt wie in ESP-IDF).
# Nicht gesetzte bool-Optionen fehlen in der Datei, wie in der echten sdkconfig.h.

function(levi_sim_sdkconfig out_file)
  cmake_parse_arguments(A "" "" "KCONFIGS;DEFAULTS;OVERRIDES" ${ARGN})
  set(names "")

  foreach(kf IN LISTS A_KCONFIGS)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${kf}")
    file(STRINGS "${kf}" lines)
    set(cur "")
    set(in_choice OFF)
    set(choice_default "")
    foreach(raw IN LISTS lines)
      string(STRIP "${raw}" l)
      if(l MATCHES "^config[ \t]+([A-Za-z0-9_]+)")
        set(cur "${CMAKE_MATCH_1}")
        list(APPEND names "${cur}")
        set(T_${cur} "")
        set(V_${cur} "")
        set(D_${cur} OFF)
        if(in_choice)
          set(T_${cur} bool)
          set(V_${cur} n)
          list(APPEND choice_members "${cur}")
        endif()
      elseif(l MATCHES "^choice")
        set(in_choice ON)
        set(cur "")
        set(choice_members "")
        set(choice_default "")
      elseif(l MATCHES "^endchoice")
        if(choice_default)
          set(V_${choice_default} y)
        endif()
        set(in_choice OFF)
        set(cur "")
      elseif(l MATCHES "^(bool|int|hex|string)([ \t]|$)")
        if(cur)
          set(T_${cur} "${CMAKE_MATCH_1}")
        endif()
      elseif(l MATCHES "^default[ \t]+(.+)$")
        set(val "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "[ \t]+if[ \t].*$" "" val "${val}")
        if(in_choice AND NOT cur)
          set(choice_default "${val}")
        elseif(cur AND NOT D_${cur})
          set(V_${cur} "${val}")
          set(D_${cur} ON)
        endif()
      elseif(l MATCHES "^(menu|endmenu|comment|if|endif)([ \t]|$)")
        set(cur "")
      endif()
    endforeach()
  endforeach()

  # sdkconfig.defaults: CONFIG_X=wert bzw. "# CONFIG_X is not set"
  foreach(df IN LISTS A_DEFAULTS A_OVERRIDES)
    if(NOT EXISTS "${df}")
      continue()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${df}")
    file(STRINGS "${df}" lines)
    foreach(l IN LISTS lines)
      if(l MATCHES "^CONFIG_([A-Za-z0-9_]+)=(.*)$")
        set(n "${CMAKE_MATCH_1}")
        if(n IN_LIST names)
          set(V_${n} "${CMAKE_MATCH_2}")
        endif()
      elseif(l MATCHES "^# CONFIG_([A-Za-z0-9_]+) is not set")
        set(n "${CMAKE_MATCH_1}")
        if(n IN_LIST names)
          set(V_${n} n)
        endif()
      endif()
    endforeach()
  endforeach()

  set(txt "/* Erzeugt von next/simulator/cmake/kconfig.cmake - nicht bearbeiten.\n")
  string(APPEND txt "   Quelle: Kconfig-Standardwerte und sdkconfig.defaults der Firmware (nur fuer den Desktop-Simulator). */\n")
  string(APPEND txt "#pragma once\n")
  list(REMOVE_DUPLICATES names)
  foreach(n IN LISTS names)
    set(t "${T_${n}}")
    set(v "${V_${n}}")
    if(t STREQUAL "bool")
      if(v STREQUAL "y")
        string(APPEND txt "#define CONFIG_${n} 1\n")
      endif()
    elseif(t STREQUAL "int" OR t STREQUAL "hex")
      if(NOT v STREQUAL "")
        string(APPEND txt "#define CONFIG_${n} ${v}\n")
      endif()
    elseif(t STREQUAL "string")
      string(APPEND txt "#define CONFIG_${n} ${v}\n")
    endif()
  endforeach()
  file(CONFIGURE OUTPUT "${out_file}" CONTENT "${txt}" @ONLY)
endfunction()
