{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Simulator: Round (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/leviluma-sim-round",
      "args": ["--no-dim"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Simulator: Bauen",
