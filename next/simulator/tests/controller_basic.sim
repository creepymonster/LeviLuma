# RockBase-Controller (320x240): Grundbedienung mit simuliertem Vorzustand
# (SIM Wohnzimmer gekoppelt, an, 80 %, Koralle). Alle Rahmen und Zustaende sind simuliert.
echo RockBase: Start und Uebersicht
expect-text "SIM Wohnzimmer" 10000
expect-text "An - 80 %" 10000
expect-text "1/1 online"
expect-switch 0 on
expect-switch 0 enabled

echo Ein/Aus ueber den Schalter der Uebersicht
click-switch 0
expect-gw 1 power 0
expect-text "Aus"
expect-switch 0 off
click-switch 0
expect-gw 1 power 1
expect-text "An - 80 %"

echo Detailansicht: Farbrad und Helligkeit
click-text "SIM Wohnzimmer"
expect-text "Koralle"
expect-text "#FF6B6B"
expect-text "80 %"
# Tipp in die rechte Haelfte des Farbrads: naechste Farbe (Orange)
click 130 150
expect-gw 1 rgb FF7828
expect-text "Orange"
expect-text "#FF7828"
# linke Haelfte: vorige Farbe (Koralle)
click 55 150
expect-gw 1 rgb FF6B6B
expect-text "Koralle"
# Farbpunkt oben direkt: Weiss
click 92 65
expect-gw 1 rgb FFFFFF
expect-text "Weiss"
# Helligkeit: Regler ganz rechts = 100 %, ganz links = 5 % (Firmware rastet in 5er-Schritten)
click-slider 0 100
expect-gw 1 brightness 100
expect-text "100 %"
click-slider 0 0
expect-gw 1 brightness 5
expect-text "5 %"
shot-device controller_detail.bmp

echo Navigation: zurueck, Einstellungen, Info
click-text @LEFT
expect-text "1/1 online"
click-text @SETTINGS
expect-text "Einstellungen"
click-text "Info"
expect-text "LeviLuma Next Controller"
expect-text "Protokoll v"
click-text @LEFT
click-text "Gateways"
expect-text "Weitere"
expect-text "SIM Kueche" 8000
expect-text "Schluessel noetig"
click-text "SIM Wohnzimmer"
expect-text "Gemeldeter Name: SIM Wohnzimmer"
expect-text "Verbindung: online"
click-text @LEFT
click-text @LEFT
click-text @LEFT
expect-text "1/1 online"
quit
