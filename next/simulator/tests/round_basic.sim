# Round Controller (240x240, rund): Grundbedienung mit simuliertem Vorzustand
# (SIM Wohnzimmer gekoppelt, an, 80 %, Koralle). Seiten wechseln durch senkrechtes Wischen.
echo Round: Seite Ein/Aus
expect-text "SIM Wohnzimmer" 10000
expect-switch 0 on 8000
expect-switch 0 enabled
click-switch 0
expect-gw 1 power 0
expect-switch 0 off
click-switch 0
expect-gw 1 power 1
expect-switch 0 on

echo Wischen nach oben: Helligkeit
drag 120 205 120 40 300
expect-text "Helligkeit"
expect-text "80 %"
# Regler mit der Maus ziehen (ueber das Ende hinaus), dann in die Mitte klicken
drag 40 160 236 160 400
expect-gw 1 brightness 100
expect-text "100 %"
drag 200 160 4 160 400
expect-gw 1 brightness 1
expect-text "1 %"
click-slider 0 50
expect-text "5" 
expect-gw 1 brightness 50 4000

echo Wischen nach oben: Farbe (rechts naechste, links vorige)
drag 120 205 120 40 300
expect-text "Koralle"
expect-text "#FF6B6B"
click 175 130
expect-gw 1 rgb FF7828
expect-text "Orange"
click 65 130
expect-gw 1 rgb FF6B6B
expect-text "Koralle"
click 65 130
expect-gw 1 rgb FFFFFF
expect-text "Weiss"
shot-device round_color.bmp

echo Wischen nach oben: Gateway
drag 120 205 120 40 300
expect-text "online, vor"
expect-text "Band verbunden"
click-text @REFRESH
expect-text "Abgleich gestartet"
click-close

echo Zurueck nach unten bis Ein/Aus
drag 120 40 120 205 300
expect-text "Weiss"
drag 120 40 120 205 300
expect-text "Helligkeit"
drag 120 40 120 205 300
expect-switch 0 on
quit
