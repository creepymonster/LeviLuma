# RockBase-Controller: Kalibrierassistent (10 Schritte) bis zum Speichern im simulierten Gateway
# (echte CalibStore-Logik, NVS fluechtig). Danach Zuruecksetzen mit Rueckfrage.
expect-text "SIM Wohnzimmer" 10000
expect-text "An - 80 %" 10000
click-text @SETTINGS
click-text "Gateways"
click-text "SIM Wohnzimmer"
click-text "Kalibrierung"
expect-text "Standard (FastLED" 6000
click-text "Kalibrierung starten"
expect-text "Schritt 1/10"
click-text "Uebernehmen"
expect-text "Schritt 2/10"
click-text "Uebernehmen"
expect-text "Schritt 3/10"
click-text "Uebernehmen"
expect-text "Schritt 4/10"
click-text "Uebernehmen"
expect-text "Schritt 5/10"
click-text "Uebernehmen"
expect-text "Schritt 6/10"
click-text "Uebernehmen"
expect-text "Schritt 7/10"
click-text "Uebernehmen"
expect-text "Schritt 8/10"
click-text "Uebernehmen"
expect-text "Schritt 9/10"
click-text "Uebernehmen"
expect-text "Schritt 10/10"
click-text "Speichern"
expect-text "Gespeichert." 6000
click-close
expect-text "Eigene Kalibrierung aktiv" 6000
click-text "Zuruecksetzen"
expect-text "Kalibrierung auf den Standard"
click-text "=Zuruecksetzen" 2
expect-text "Gespeichert." 6000
click-close
expect-text "Standard (FastLED" 6000
quit
