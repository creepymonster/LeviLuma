# RockBase-Controller: Kopplung ohne Schluessel (Kopplungsfenster), mit Schluessel (Bildschirmtastatur)
# und Entkoppeln. Gestartet mit --gateways 3. Der Schluessel ist ein reiner Simulationsschluessel.
expect-text "SIM Wohnzimmer" 10000
click-text @SETTINGS
click-text "Gateways"
expect-text "SIM Flur" 8000
expect-text "Kopplung am Gateway freigeben"

echo Ohne Schluessel, Fenster geschlossen: Ablehnung
click-text "SIM Flur"
expect-text "Koppeln: SIM Flur"
click-text "=Koppeln"
expect-text "nicht freigegeben" 8000
echo BOOT-Taste am simulierten Gateway, dann koppeln
gw 3 pairing
wait 300
click-text "=Koppeln"
expect-text "Gateway gekoppelt." 8000
expect-gw 3 paired 1
click-close
expect-text "Gemeldeter Name: SIM Flur"

echo Gateway mit Schluessel: Eingabe ueber die Bildschirmtastatur der Firmware
click-text @LEFT
click-text "SIM Kueche"
expect-text "Koppeln: SIM Kueche"
expect-text "Schluessel wie am Gateway"
click-button 0
click-button 0
click-button 1
click-button 1
click-button 2
click-button 2
click-button 3
click-button 3
click-button 4
click-button 4
click-button 5
click-button 5
click-button 6
click-button 6
click-button 7
click-button 7
click-button 8
click-button 8
click-button 9
click-button 9
click-button A
click-button A
click-button B
click-button B
click-button C
click-button C
click-button D
click-button D
click-button E
click-button E
click-button F
click-button F
click-button @OK
expect-text "Gateway gekoppelt." 8000
expect-gw 2 paired 1
click-close
expect-text "Schluessel: individuell (verschluesselt)"

echo Entkoppeln mit Rueckfrage (Inhalt nach oben ziehen, der Knopf liegt unterhalb)
drag 160 215 160 60 400
click-text "Entkoppeln"
expect-text "Gateway entkoppeln?"
click-text "=Entkoppeln" 1
expect-gw 2 paired 0 8000
expect-text "Weitere"
click-text @LEFT
click-text @LEFT
expect-text "2/2 online" 8000
quit
