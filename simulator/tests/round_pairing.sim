# Round Controller: Entkoppeln, Suchen, Kopplung mit falschem und richtigem Schluessel (Simulationsschluessel),
# dann Kopplung ohne Schluessel. Genau ein Gateway darf gekoppelt sein.
expect-switch 0 on 10000
echo Gateway-Seite ueber den geheimen Weg (5x auf den Namen tippen)
click-text "SIM Wohnzimmer"
click-text "SIM Wohnzimmer"
click-text "SIM Wohnzimmer"
click-text "SIM Wohnzimmer"
click-text "SIM Wohnzimmer"
expect-text @TRASH

echo Entkoppeln
click-text @TRASH
expect-text "Gateway entkoppeln?"
click-text "=Ja"
expect-gw 1 paired 0 8000
expect-text "Kein Gateway"

echo Suchen, Gateway mit Schluessel waehlen, falscher Schluessel
click-text "Suchen"
expect-text "=Gateways"
expect-text "SIM Kueche" 8000
expect-text "SIM Wohnz" 8000
# Liste baut sich neu auf, sobald alle Gateways ihre Daten gemeldet haben; erst danach waehlen
wait 1500
click-text "SIM Kueche"
expect-text "0/32"
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
click-button 1
expect-text "32/32"
click-button @OK
expect-text "Schluessel falsch?" 12000
expect-gw 2 paired 0

echo Richtiger Schluessel
click-text "SIM Kueche"
expect-text "0/32"
click-button 0
click-button 0
click-button 1
click-button 1
click-button 2
click-button 2
click-button 3
click-button 3
click-button 4
click-button 4
click-button 5
click-button 5
click-button 6
click-button 6
click-button 7
click-button 7
click-button 8
click-button 8
click-button 9
click-button 9
click-button A
click-button A
click-button B
click-button B
click-button C
click-button C
click-button D
click-button D
click-button E
click-button E
click-button F
click-button F
click-button @OK
expect-text "Gekoppelt" 8000
expect-gw 2 paired 1
click-close
expect-text "SIM Kueche"
expect-switch 0 on

echo Nur ein Gateway: Seite Gateway zeigt das gekoppelte, keine Suche
click-text "SIM Kueche"
click-text "SIM Kueche"
click-text "SIM Kueche"
click-text "SIM Kueche"
click-text "SIM Kueche"
expect-text "SIM Kueche"
expect-text @TRASH
expect-no-text "Suchen"
quit
