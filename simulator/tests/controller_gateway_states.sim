# RockBase-Controller: Gateway-Zustaende kommen ueber denselben Weg wie bei echter Hardware
# (simuliertes Gateway -> ESP-NOW-Rahmen -> CtrlLink -> appView -> Oberflaeche). Alles simuliert.
expect-text "An - 80 %" 10000

echo Band getrennt / verbunden
gw 1 ble 0
expect-text "Band nicht verbunden"
expect-switch 0 disabled
gw 1 ble 1
expect-text "An - 80 %"
expect-switch 0 enabled

echo Zustandsaenderung am Gateway (z. B. anderer Controller)
gw 1 power 0
expect-text "Aus"
expect-switch 0 off
gw 1 brightness 30
gw 1 power 1
expect-text "An - 30 %"
expect-switch 0 on

echo Musikmodus: im Gateway-Zustand, eine Farbwahl beendet ihn (wie Legacy setRGB)
gw 1 music 1
expect-gw 1 music 1
click-text "SIM Wohnzimmer"
expect-text "Koralle"
click 130 150
expect-gw 1 rgb FF7828
expect-gw 1 music 0
click-text @LEFT

echo Gateway offline / online (Erkennung ueber ausbleibende Beacons, ca. 6,5 s)
gw 1 online 0
expect-text "Offline" 12000
expect-text "0/1 online"
expect-switch 0 disabled
gw 1 online 1
expect-text "An - 30 %" 12000
expect-text "1/1 online"

echo Paketverlust 30 %: Befehl kommt durch Wiederholungen an
loss 30
click-switch 0
expect-gw 1 power 0 10000
expect-text "Aus" 10000
loss 0
quit
