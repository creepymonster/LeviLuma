cmake_minimum_required(VERSION 3.20)
# Prueft, dass der Simulator ohne ESP-IDF/FreeRTOS auskommt (cmake -P, aufgerufen von CTest).
#  1. keine Include-Pfade in ESP-IDF (IDF_PATH, esp-idf, components/freertos ...)
#  2. keine uebersetzte Quelle bindet ESP-IDF-/FreeRTOS-Header ein (Bloecke unter #ifdef ESP_PLATFORM
#     werden ausgelassen, sie sind ausserhalb von ESP-IDF inaktiv). Erlaubt sind nur die zwei
#     esp_lcd-Platzhalter aus simulator/shim (Typnamen fuer controller/main/board.h).
#  3. im shim-Ordner liegen nur diese Platzhalter
#  4. falls vorhanden (Makefile-Generator): die vom Compiler geschriebenen Abhaengigkeitsdateien (*.o.d)
#     enthalten keinen ESP-IDF-/FreeRTOS-Header, auch nicht indirekt
file(STRINGS "${LIST}" lines)
set(mode src)
set(srcs "")
set(incs "")
foreach(l IN LISTS lines)
  if(l STREQUAL "INCLUDES")
    set(mode inc)
  elseif(NOT l STREQUAL "")
    if(mode STREQUAL "src")
      list(APPEND srcs "${l}")
    else()
      list(APPEND incs "${l}")
    endif()
  endif()
endforeach()

set(errors "")
foreach(i IN LISTS incs)
  if(i MATCHES "esp-idf|/components/freertos|/components/esp_" OR (DEFINED ENV{IDF_PATH} AND NOT "$ENV{IDF_PATH}" STREQUAL "" AND i MATCHES "^$ENV{IDF_PATH}"))
    list(APPEND errors "Include-Pfad zeigt in ESP-IDF: ${i}")
  endif()
endforeach()

set(forbidden "freertos/|esp_now\\.h|esp_wifi|esp_timer|esp_log|esp_event|esp_mac|esp_netif|esp_random|esp_heap_caps|esp_system|esp_check|esp_err\\.h|nvs_flash|nvs\\.h|driver/|esp_lcd_panel_st7789|esp_zigbee|esp_lcd_panel_vendor|sdkconfig\\.h")
set(n 0)
foreach(s IN LISTS srcs)
  if(NOT IS_ABSOLUTE "${s}")
    set(s "${SIM_DIR}/${s}")
  endif()
  if(NOT EXISTS "${s}")
    continue()
  endif()
  math(EXPR n "${n} + 1")
  file(STRINGS "${s}" pp REGEX "^[ \t]*#[ \t]*(if|ifdef|ifndef|else|elif|endif|include)")
  set(stack "")
  foreach(x IN LISTS pp)
    if(x MATCHES "^[ \t]*#[ \t]*(ifdef[ \t]+ESP_PLATFORM|if[ \t]+defined[ \t]*\\(?[ \t]*ESP_PLATFORM)")
      list(APPEND stack esp)
    elseif(x MATCHES "^[ \t]*#[ \t]*if")
      list(APPEND stack other)
    elseif(x MATCHES "^[ \t]*#[ \t]*(else|elif)")
      list(LENGTH stack k)
      if(k GREATER 0)
        list(POP_BACK stack top)
        if(top STREQUAL "esp")
          list(APPEND stack notesp)
        else()
          list(APPEND stack "${top}")
        endif()
      endif()
    elseif(x MATCHES "^[ \t]*#[ \t]*endif")
      list(LENGTH stack k)
      if(k GREATER 0)
        list(POP_BACK stack)
      endif()
    elseif(NOT "esp" IN_LIST stack AND x MATCHES "[<\"](${forbidden})")
      # sdkconfig.h ist erlaubt: der Simulator erzeugt sie selbst (build/generated)
      if(NOT x MATCHES "sdkconfig\\.h")
        list(APPEND errors "${s}: ${x}")
      endif()
    endif()
  endforeach()
endforeach()

file(GLOB shims RELATIVE "${SIM_DIR}/shim" "${SIM_DIR}/shim/*")
list(SORT shims)
if(NOT shims STREQUAL "esp_lcd_panel_io.h;esp_lcd_panel_ops.h")
  list(APPEND errors "shim/ enthaelt mehr als die esp_lcd-Platzhalter: ${shims}")
endif()

# Tatsaechlich eingebundene Header laut Compiler
set(nd 0)
if(BUILD_DIR)
  file(GLOB_RECURSE deps "${BUILD_DIR}/CMakeFiles/leviluma-sim-controller.dir/*.d" "${BUILD_DIR}/CMakeFiles/leviluma-sim-round.dir/*.d"
       "${BUILD_DIR}/CMakeFiles/levi_sim_core.dir/*.d")
  foreach(d IN LISTS deps)
    math(EXPR nd "${nd} + 1")
    file(READ "${d}" txt)
    string(REGEX MATCHALL "[^ \t\r\n\\\\:]+\\.h" hdrs "${txt}")
    foreach(h IN LISTS hdrs)
      get_filename_component(base "${h}" NAME)
      if(h MATCHES "esp-idf|/freertos/" OR (base MATCHES "^(esp_|nvs)" AND NOT h MATCHES "simulator/shim/esp_lcd_panel_(io|ops)\\.h$"))
        list(APPEND errors "${d}: ${h}")
      endif()
      if(base STREQUAL "sdkconfig.h" AND NOT h MATCHES "/generated/(controller|round)/sdkconfig\\.h$")
        list(APPEND errors "${d}: fremde sdkconfig.h ${h}")
      endif()
    endforeach()
  endforeach()
endif()

if(errors)
  list(REMOVE_DUPLICATES errors)
  list(JOIN errors "\n  " msg)
  message(FATAL_ERROR "ESP-IDF-Abhaengigkeit im Simulator:\n  ${msg}")
endif()
message(STATUS "Keine ESP-IDF-/FreeRTOS-Abhaengigkeit: ${n} Quelldateien, ${nd} Compiler-Abhaengigkeitsdateien geprueft.")
